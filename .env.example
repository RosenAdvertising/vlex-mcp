# Required: subscription key from your developer.vlex.com portal account.
VLEX_API_KEY=replace-with-your-vlex-subscription-key

# Optional HTTP behavior. The defaults shown are used when these are omitted.
VLEX_HTTP_TIMEOUT_SECONDS=30
VLEX_MAX_RETRIES=3
VLEX_BACKOFF_BASE_SECONDS=0.5
VLEX_MAX_BACKOFF_SECONDS=8
